<Project>

  <!-- Shared by every project in the repository (the web app and tools). -->
  <PropertyGroup>
    <!-- Product version: shown in the web app's header and stamped on the assemblies. It comes from git:
         - a release built from a version tag (v1.2.0) uses the tag's version (.github/workflows/release.yml);
         - any other build uses the newest version tag plus the commits since it, e.g. 1.2.0+3
           (Directory.Build.targets);
         - DefaultVersion is used only when there is no git, repository or version tag. -->
    <DefaultVersion>1.0</DefaultVersion>
    <Version>$(DefaultVersion)</Version>
    <!-- Keep the commit hash out of the displayed version (the SDK would append "+<hash>"). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>GS Point3D Web</Product>
    <Copyright>Copyright (C) Rob Morgan</Copyright>
    <!-- GNU GPL version 3 or later (LICENSE), as the source headers say. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

</Project>
