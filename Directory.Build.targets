<Project>

  <!--
    Version from git, for builds that aren't given one: local builds, dotnet run, and the build on each push.
    It is the newest version tag (v1.0.1) plus how many commits have been made since it:

      on the tag itself          1.0.1
      3 commits after it         1.0.1+3     (file version 1.0.1.3)

    A release (.github/workflows/release.yml) passes -p:Version from its tag, so Version no longer equals
    DefaultVersion and this is skipped. Without git, a repository, or a version tag, DefaultVersion
    (Directory.Build.props) is used. Set DisableGitVersion=true to skip it.
  -->
  <Target Name="SetVersionFromGit"
          BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes;GenerateAssemblyInfo"
          Condition="'$(Version)' == '$(DefaultVersion)' and '$(DisableGitVersion)' != 'true'">
    <Exec Command="git describe --tags --long --match &quot;v[0-9]*&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>

    <!-- e.g. v1.0.1-3-g70ac35d, or v1.1.0-rc.1-0-g1234abc: the tag's version, then the commit count. -->
    <PropertyGroup Condition="'$(_GitDescribeExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitDescribe)', '^v\d+(\.\d+){1,2}(-[0-9A-Za-z.-]+)?-\d+-g[0-9a-f]+$'))">
      <_GitTagVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '^v(.+)-(\d+)-g[0-9a-f]+$', '$1'))</_GitTagVersion>
      <_GitCommits>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '^v(.+)-(\d+)-g[0-9a-f]+$', '$2'))</_GitCommits>
      <!-- The numeric part, always major.minor.patch, for the assembly and file versions. -->
      <_GitNumericVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitTagVersion)', '^(\d+(\.\d+){1,2}).*$', '$1'))</_GitNumericVersion>
      <_GitNumericVersion Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitNumericVersion)', '^\d+\.\d+$'))">$(_GitNumericVersion).0</_GitNumericVersion>

      <Version>$(_GitTagVersion)</Version>
      <Version Condition="'$(_GitCommits)' != '0'">$(_GitTagVersion)+$(_GitCommits)</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
      <AssemblyVersion>$(_GitNumericVersion).0</AssemblyVersion>
      <FileVersion>$(_GitNumericVersion).$(_GitCommits)</FileVersion>
    </PropertyGroup>
  </Target>

</Project>
