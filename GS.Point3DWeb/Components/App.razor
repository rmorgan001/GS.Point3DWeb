<!DOCTYPE html>
<html lang="@Languages.Current.Code">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070b0e" />
    <link rel="icon" type="image/x-icon" href="@Assets["favicon.ico"]" />
    @* Barlow fonts are served by the app (wwwroot/fonts), so it needs no internet connection. *@
    <link rel="stylesheet" href="@Assets["fonts/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GS.Point3DWeb.styles.css"]" />
    @* Before the body is drawn: puts the server list back the way this browser left it (collapsed or not). *@
    <script src="@Assets["sidebar.js"]"></script>
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["app.js"]"></script>
</body>

</html>
