<h2 class="dialog-title">@ViewModel.Title</h2>

<form class="edit-form" @onsubmit="() => ViewModel.ConfirmCommand.ExecuteAsync(null)" novalidate>
    <div class="field-row">
        <label class="field field-grow">
            <span class="field-label">@L.T("Server Name")</span>
            <input type="text" autofocus
                   class="@(ViewModel.ServerNameError is null ? null : "has-error")"
                   aria-invalid="@(ViewModel.ServerNameError is not null)"
                   @bind="ViewModel.ServerName" @bind:event="oninput" />
            @if (ViewModel.ServerNameError is not null)
            {
                <span class="field-error">@ViewModel.ServerNameError</span>
            }
        </label>
        <label class="field field-poll">
            <span class="field-label">@L.T("Polling (seconds)")</span>
            <input type="number" min="@AlpacaServer.MinPollSeconds" max="@AlpacaServer.MaxPollSeconds" step="0.1"
                   title="@L.T("How often the server is asked for its position (0.5 to 5.0 seconds)")"
                   class="@(ViewModel.PollSecondsError is null ? null : "has-error")"
                   aria-invalid="@(ViewModel.PollSecondsError is not null)"
                   @bind="ViewModel.PollSeconds" @bind:event="oninput" />
            @if (ViewModel.PollSecondsError is not null)
            {
                <span class="field-error">@ViewModel.PollSecondsError</span>
            }
        </label>
    </div>

    <div class="field-row">
        <label class="field field-grow">
            <span class="field-label">@L.T("Url")</span>
            <input type="url" spellcheck="false"
                   class="@(ViewModel.UrlError is null ? null : "has-error")"
                   aria-invalid="@(ViewModel.UrlError is not null)"
                   @bind="ViewModel.Url" @bind:event="oninput" />
            @if (ViewModel.UrlError is not null)
            {
                <span class="field-error">@ViewModel.UrlError</span>
            }
        </label>
    </div>

    <div class="field-row">
        <label class="field field-grow">
            <span class="field-label">@L.T("User Name")</span>
            <input type="text" autocomplete="off" @bind="ViewModel.UserName" @bind:event="oninput" />
        </label>
        <label class="field field-grow">
            <span class="field-label">@L.T("Password")</span>
            <span class="password">
                <input type="@(_showPassword ? "text" : "password")" autocomplete="new-password"
                       @bind="ViewModel.Password" @bind:event="oninput" />
                <button type="button" class="reveal"
                        title="@(_showPassword ? L.T("Hide password") : L.T("Show password"))"
                        aria-label="@(_showPassword ? L.T("Hide password") : L.T("Show password"))"
                        @onclick="() => _showPassword = !_showPassword">
                    @(_showPassword ? L.T("Hide") : L.T("Show"))
                </button>
            </span>
        </label>
    </div>

    @* Read-only identifiers, kept together below the editable settings. *@
    <div class="field-row field-row-info" role="group" aria-label="@L.T("Server details (read-only)")">
        <label class="field field-grow">
            <span class="field-label">@L.T("ID")</span>
            <input type="text" value="@ViewModel.IdGuid" readonly />
        </label>
        <label class="field field-txn">
            <span class="field-label">@L.T("Client Transaction ID")</span>
            <input type="text" value="@ViewModel.ClientTransactionId" readonly />
        </label>
    </div>

    <div class="dialog-buttons">
        <button type="submit" class="dialog-button">@ViewModel.AcceptText</button>
        <button type="button" class="dialog-button" @onclick="() => ViewModel.CancelCommand.ExecuteAsync(null)">
            @ViewModel.CancelText
        </button>
    </div>
</form>

@code {
    [Parameter, EditorRequired]
    public EditServerDialogViewModel ViewModel { get; set; } = default!;

    private bool _showPassword;
}
