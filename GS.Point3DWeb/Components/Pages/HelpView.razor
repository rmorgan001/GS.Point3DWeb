@page "/help"
@inherits LocalizedComponentBase

@* The user guide, opened in its own window from the Home page's help button, in the chosen language
   (Components/Help/Help<Language>.razor). In-page links there use "help#…" (not "#…"), as a bare
   fragment would resolve against the base address and go to the home page. *@

<PageTitle>@L.T("Help") · GS Point3D Web</PageTitle>

<div class="help-page">
    <header class="help-header">
        <h1>@L.T("Help")</h1>
        <span class="help-version">GS Point3D Web v@(AppVersion.Display)</span>
    </header>

    <div class="help-body">
        @* The guide in the chosen language, or English if it has none. *@
        @switch (Languages.Current.Code)
        {
            case "de": <HelpDe />; break;
            case "es": <HelpEs />; break;
            case "fr": <HelpFr />; break;
            case "it": <HelpIt />; break;
            case "zh-Hans": <HelpZhHans />; break;
            default: <HelpEn />; break;
        }
    </div>
</div>
