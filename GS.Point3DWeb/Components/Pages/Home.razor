@page "/"
@inherits MvvmComponentBase<HomeViewModel>
@inject NavigationManager Navigation

<PageTitle>GS Point3D Web</PageTitle>

<div class="home">
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>GS Point3D Web</span>
            <span class="brand-version" title="@L.T("Version {0}", AppVersion.Display)">v@(AppVersion.Display)</span>
            <span class="brand-sub">@L.T("Alpaca mount viewer")</span>
        </div>

        <div class="header-tools">
            <span class="connected-count" title="@L.T("Servers connected")">
                <span class="dot @(ConnectedCount > 0 ? "on" : null)"></span>
                @L.T("{0} of {1} connected", ConnectedCount, ViewModel.Count)
            </span>

            <button type="button" class="key-button @(ViewModel.IsLicensed ? "licensed" : null)"
                    title="@(ViewModel.IsLicensed ? L.T("Feature key installed") : L.T("Free version: add a feature key for more views and servers"))"
                    @onclick="() => ViewModel.FeatureKeyCommand.ExecuteAsync(null)">
                <Icon Kind="@(ViewModel.IsLicensed ? "Key" : "Lock")" Size="16" />
                <span>@(ViewModel.IsLicensed ? L.T("Unlocked") : L.T("Free"))</span>
            </button>

            <div class="views" role="group" aria-label="@L.T("Number of 3D views")">
                <span class="views-label">@L.T("Views")</span>
                <div class="segmented">
                    @for (var n = 1; n <= ViewModel.Quadrants.Length; n++)
                    {
                        var count = n;
                        var locked = count > ViewModel.MaxViews;
                        <button type="button" class="@(ViewModel.ViewCount == count ? "selected" : null) @(locked ? "locked" : null)"
                                title="@ViewsTitle(count, locked)"
                                aria-pressed="@(ViewModel.ViewCount == count)"
                                @onclick="() => ViewModel.ViewCount = count">@count</button>
                    }
                </div>
            </div>

            @* Language menu, as on greenswamp.org: a <details> drop-down showing the globe and the current
               language's code. Each entry is a plain link to /culture/set, which saves the choice and reloads
               the page. target="_top" keeps Blazor's router from intercepting it, so it is a real page load
               that works without the circuit (and Ctrl-click opens a new tab). wwwroot/app.js closes the menu
               on an outside click or Escape, and on a click of the language already showing. *@
            @{
                var currentLanguage = Languages.Current;
                var returnPath = ReturnPath;
            }
            <details class="lang-menu">
                <summary aria-label="@($"{L.T("Language")}: {currentLanguage.NativeName}")">
                    <span class="lang-globe" aria-hidden="true">🌐</span>
                    <span class="lang-current">@currentLanguage.ShortCode</span>
                </summary>
                <ul>
                    @foreach (var language in Languages.All)
                    {
                        var current = language == currentLanguage;
                        <li>
                            <a href="@LanguageLink(language, returnPath)" target="_top" lang="@language.Code" hreflang="@language.Code"
                               class="@(current ? "current" : null)" aria-current="@(current ? "true" : null)">@language.NativeName</a>
                        </li>
                    }
                </ul>
            </details>
        </div>
    </header>

    <div class="workspace">
    <aside class="sidebar" @ondragenter="() => _hoverQuadrant = -1">
        <div class="sidebar-header">
            <h2>@L.T("Alpaca Servers")</h2>
            <span class="count" title="@L.T("Servers in the list")">
                @ViewModel.Count@(ViewModel.IsLicensed ? "" : $" / {FeatureKeyService.FreeMaxServers}")
            </span>
        </div>

        <div class="toolbar" role="toolbar" aria-label="@L.T("Server commands")">
            <button type="button" class="icon-btn" title="@L.T("Add")" aria-label="@L.T("Add")"
                    @onclick="() => ViewModel.AddCommand.Execute(null)">
                <Icon Kind="Plus" />
            </button>
            <button type="button" class="icon-btn" title="@L.T("Network Discovery")" aria-label="@L.T("Network Discovery")"
                    @onclick="() => ViewModel.DiscoveryCommand.ExecuteAsync(null)">
                <Icon Kind="Search" />
            </button>
            <button type="button" class="icon-btn @(ViewModel.SelectedAlpacaServer?.IsConnected == true ? "active" : null)"
                    title="@ConnectText" aria-label="@ConnectText" disabled="@ViewModel.IsBusy"
                    @onclick="() => ViewModel.ConnectCommand.ExecuteAsync(null)">
                <Icon Kind="Connection" />
            </button>
            <button type="button" class="icon-btn" title="@L.T("Save")" aria-label="@L.T("Save")"
                    @onclick="() => ViewModel.SaveCommand.ExecuteAsync(null)">
                <Icon Kind="ContentSave" />
            </button>
            <span class="toolbar-spacer"></span>
            <button type="button" class="icon-btn danger" title="@L.T("Delete")" aria-label="@L.T("Delete")"
                    disabled="@(ViewModel.SelectedAlpacaServer is null)"
                    @onclick="() => ViewModel.DeleteCommand.ExecuteAsync(ViewModel.SelectedAlpacaServer)">
                <Icon Kind="Delete" />
            </button>
        </div>

        <nav class="server-nav" aria-label="@L.T("Alpaca Servers")">
            <ul class="server-list">
                @foreach (var server in ViewModel.AlpacaServers)
                {
                    var allowed = ViewModel.IsServerAllowed(server);
                    <li>
                        <button type="button"
                                class="server-item @(server == ViewModel.SelectedAlpacaServer ? "selected" : null) @(allowed ? null : "locked")"
                                title="@(allowed ? ServerTooltip(server) : LockedTooltip(server))"
                                draggable="@(allowed ? "true" : "false")"
                                data-server-id="@server.IdGuid"
                                @ondragstart="() => ViewModel.StartDrag(server)"
                                @ondragend="() => { ViewModel.EndDrag(); _hoverQuadrant = -1; }"
                                @onclick="() => ViewModel.SelectServerCommand.Execute(server)"
                                @ondblclick="() => ViewModel.EditServerCommand.ExecuteAsync(server)"
                                @onkeydown="e => OnServerKeyDown(e, server)">
                            <span class="status @(server.IsConnected ? "connected" : null)"
                                  title="@(server.IsConnected ? L.T("Connected") : L.T("Not connected"))"></span>
                            <span class="server-text">
                                <span class="name">@server.ServerName</span>
                                <span class="address">@ServerAddress(server)</span>
                            </span>
                            @if (!allowed)
                            {
                                <span class="lock" aria-label="@L.T("Needs a feature key")"><Icon Kind="Lock" Size="14" /></span>
                            }
                        </button>
                    </li>
                }
            </ul>
        </nav>

        <p class="sidebar-hint">
            @L.T("Drag a server onto a view to show its mount. Double-click a server (or press F2) to edit it.")
        </p>
    </aside>

    <section class="model-panel views-@ViewModel.ViewCount @(ViewModel.DragServer is not null ? "dragging" : null)" aria-label="@L.T("3D models")">
        @for (var i = 0; i < ViewModel.ViewCount; i++)
        {
            var index = i;
            var quadrant = ViewModel.Quadrants[index];
            @* Drop handlers live on the quadrant itself so a fast drag can't land before the
               overlay renders. dragleave isn't used: it fires when moving onto child elements. *@
            <div class="quadrant"
                 @ondragenter="() => _hoverQuadrant = index"
                 @ondragover:preventDefault
                 @ondrop="() => OnDrop(index)"
                 @ondrop:preventDefault>
                @if (quadrant.Server is { } lockedServer && !ViewModel.IsServerAllowed(lockedServer))
                {
                    <div class="quadrant-empty">
                        <span class="empty-mark" aria-hidden="true"><Icon Kind="Lock" Size="22" /></span>
                        <p class="empty-title">@lockedServer.ServerName</p>
                        <p>@L.T("Needs a feature key (free version: {0} servers)", FeatureKeyService.FreeMaxServers)</p>
                    </div>
                }
                else if (quadrant.Server is { } server)
                {
                    <FlipCard @key="quadrant.Key" Flipped="quadrant.Flipped">
                        <Front>
                            <Model3DView @ref="_views[index]" Server="server"
                                         OnSettings="() => ViewModel.ToggleFlip(index)"
                                         OnClose="() => ViewModel.ClearQuadrant(index)"
                                         OnConnectionChanged="StateHasChanged"
                                         OnSettingsChanged="ViewModel.ServerSettingsChangedAsync" />
                        </Front>
                        <Back>
                            <ViewSettingsPanel Server="server"
                                               OnSaveCamera="() => SaveCameraAsync(index)"
                                               OnResetCamera="() => ResetCameraAsync(index)"
                                               OnClearCamera="() => ClearCameraAsync(index)"
                                               OnDone="() => ViewModel.ToggleFlip(index)"
                                               OnChanged="ViewModel.ServerSettingsChangedAsync" />
                        </Back>
                    </FlipCard>
                }
                else
                {
                    <div class="quadrant-empty">
                        <span class="empty-mark" aria-hidden="true"><Icon Kind="Connection" Size="22" /></span>
                        <p class="empty-title">@L.T("View {0}", index + 1)</p>
                        <p>@L.T("Drag a server here")</p>
                    </div>
                }

                @if (ViewModel.DragServer is not null)
                {
                    <div class="drop-zone @(_hoverQuadrant == index ? "over" : null)">
                        <span>@L.T("Show {0}", ViewModel.DragServer.ServerName)</span>
                    </div>
                }
            </div>
        }
    </section>
    </div>
</div>

@code {
    private int _hoverQuadrant = -1;

    protected override void OnInitialized()
    {
        // Changes raised by other tabs (shared server list, layout, feature key) run on this page's renderer.
        ViewModel.Dispatch = action => InvokeAsync(action);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // After the first interactive render (never during prerendering), so the dialog reaches the page.
        if (firstRender) _ = ViewModel.ShowStartupNoticeAsync();
    }

    /// <summary>The 3D view in each quadrant, to read or set its camera.</summary>
    private readonly Model3DView?[] _views = new Model3DView?[SettingsService.QuadrantCount];

    /// <summary>Saves the quadrant's current camera to its server's settings.</summary>
    private async Task SaveCameraAsync(int index)
    {
        if (ViewModel.Quadrants[index].Server is not { } server || _views[index] is not { } view) return;
        var camera = await view.GetCameraAsync();
        if (camera is null) return;
        server.Camera = camera;
        await ViewModel.ServerSettingsChangedAsync();
    }

    /// <summary>Moves the quadrant's camera back to its server's saved view.</summary>
    private Task ResetCameraAsync(int index) => _views[index]?.ResetCameraAsync() ?? Task.CompletedTask;

    /// <summary>Forgets the server's saved view and returns this quadrant to the default camera.</summary>
    private async Task ClearCameraAsync(int index)
    {
        if (ViewModel.Quadrants[index].Server is not { } server) return;
        server.Camera = null;
        await ViewModel.ServerSettingsChangedAsync();
        await ResetCameraAsync(index);
    }

    private void OnDrop(int index)
    {
        _hoverQuadrant = -1;
        ViewModel.DropOnQuadrant(index);
    }

    private string ConnectText => ViewModel.SelectedAlpacaServer?.IsConnected == true ? L.T("Disconnect") : L.T("Connect");

    private static string ViewsTitle(int count, bool locked)
        => locked ? L.T("{0} views need a feature key", count)
            : count == 1 ? L.T("Show 1 3D view") : L.T("Show {0} 3D views", count);

    private static string LockedTooltip(AlpacaServer server)
        => $"{server.Url}\n{L.T("Needs a feature key (free version: {0} servers)", FeatureKeyService.FreeMaxServers)}";

    /// <summary>
    /// This page's path and query, escaped for the redirect. It includes the app's base path, so the
    /// redirect comes back here even when the app is hosted under a sub-path.
    /// </summary>
    private string ReturnPath => Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);

    /// <summary>The address that saves a language in the culture cookie and comes back to this page.</summary>
    private static string LanguageLink(Language language, string returnPath)
        => $"culture/set?culture={Uri.EscapeDataString(language.Code)}&redirectUri={returnPath}";

    private int ConnectedCount => ViewModel.AlpacaServers.Count(s => s.IsConnected);

    private static string ServerTooltip(AlpacaServer server) => $"{server.Url}\n{L.T("Double-click (or F2) to edit")}";

    /// <summary>Short address for the list: host:port and device number.</summary>
    private static string ServerAddress(AlpacaServer server)
    {
        if (!Uri.TryCreate(server.Url, UriKind.Absolute, out var uri)) return server.Url;
        var device = uri.Segments.LastOrDefault()?.Trim('/');
        return int.TryParse(device, out var number)
            ? $"{uri.Authority} · {L.T("telescope {0}", number)}"
            : uri.Authority;
    }

    private Task OnServerKeyDown(KeyboardEventArgs e, AlpacaServer server)
        => e.Key == "F2" ? ViewModel.EditServerCommand.ExecuteAsync(server) : Task.CompletedTask;
}
