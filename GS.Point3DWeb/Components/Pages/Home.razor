@page "/"
@inherits MvvmComponentBase<HomeViewModel>
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>GS Point3D Web</PageTitle>

<div class="home">
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>GS Point3D Web</span>
            <span class="brand-version" title="@L.T("Version {0}", AppVersion.Display)">v@(AppVersion.Display)</span>
            <span class="brand-sub">@L.T("Alpaca mount viewer")</span>
        </div>

        @* In a narrow window the menu folds away behind this button (Home.razor.css); wide windows never show it. *@
        <button type="button" class="icon-btn menu-toggle @(_menuOpen ? "open" : null)" aria-controls="header-tools"
                aria-expanded="@(_menuOpen ? "true" : "false")"
                title="@(_menuOpen ? L.T("Hide the menu") : L.T("Show the menu"))"
                aria-label="@(_menuOpen ? L.T("Hide the menu") : L.T("Show the menu"))"
                @onclick="() => _menuOpen = !_menuOpen">
            <Icon Kind="@(_menuOpen ? "Close" : "Menu")" Size="20" />
        </button>

        <div class="header-tools @(_menuOpen ? "open" : null)" id="header-tools">
            <span class="connected-count" title="@L.T("Servers connected")">
                <span class="dot @(ConnectedCount > 0 ? "on" : null)"></span>
                @L.T("{0} of {1} connected", ConnectedCount, ViewModel.Count)
            </span>

            @* Stay on top: keeps this browser window above all other windows. Done by the app with Win32 (a page
               can't), so it's offered only when the app runs on Windows, and works only when the browser is on
               the same computer; if it isn't, the box clears itself and its tooltip says why. *@
            @if (WindowPin.IsSupported)
            {
                <label class="key-button pin-toggle @(_onTop ? "on" : null) @(_onTopBusy ? "busy" : null)"
                       title="@(_onTopMessage ?? L.T("Keep this browser window on top of all other windows"))">
                    <input type="checkbox" checked="@_onTop" disabled="@_onTopBusy"
                           @onchange="e => SetOnTopAsync(e.Value is true || (e.Value is string s && bool.TryParse(s, out var b) && b))" />
                    <span class="pin-box" aria-hidden="true"></span>
                    <Icon Kind="Pin" Size="15" />
                    <span>@L.T("On top")</span>
                    @if (_onTopMessage is not null)
                    {
                        <span class="pin-warn" aria-hidden="true">!</span>
                    }
                </label>
            }

            @* Opens the log viewer (/log) in its own window; a plain link (new tab) if pop-ups are blocked. *@
            <a class="key-button log-button" href="log" target="gs-point3dweb-log"
               title="@L.T("View the log in a separate window")"
               data-popup="width=1100,height=750">
                <Icon Kind="FileDocument" Size="16" />
                <span>@L.T("Log")</span>
            </a>

            @* Feature key button: hidden for now (all four views are free). To bring it back, remove this
               comment's start and end lines.
            <button type="button" class="key-button @(ViewModel.IsLicensed ? "licensed" : null)"
                    title="@(ViewModel.IsLicensed ? L.T("Feature key installed") : L.T("Free version: add a feature key for more views and servers"))"
                    @onclick="() => ViewModel.FeatureKeyCommand.ExecuteAsync(null)">
                <Icon Kind="@(ViewModel.IsLicensed ? "Key" : "Lock")" Size="16" />
                <span>@(ViewModel.IsLicensed ? L.T("Unlocked") : L.T("Free"))</span>
            </button>
            *@

            <div class="views" role="group" aria-label="@L.T("Number of 3D views")">
                <span class="views-label">@L.T("Views")</span>
                <div class="segmented">
                    @for (var n = 1; n <= ViewModel.Quadrants.Length; n++)
                    {
                        var count = n;
                        var locked = count > ViewModel.MaxViews;
                        <button type="button" class="@(ViewModel.ViewCount == count ? "selected" : null) @(locked ? "locked" : null)"
                                title="@ViewsTitle(count, locked)"
                                aria-pressed="@(ViewModel.ViewCount == count)"
                                @onclick="() => ViewModel.ViewCount = count">@count</button>
                    }
                </div>
            </div>

            @* Language menu, as on greenswamp.org: a <details> drop-down showing the globe and the current
               language's code. Each entry is a plain link to /culture/set, which saves the choice and reloads
               the page. target="_top" keeps Blazor's router from intercepting it, so it is a real page load
               that works without the circuit (and Ctrl-click opens a new tab). wwwroot/app.js closes the menu
               on an outside click or Escape, and on a click of the language already showing. *@
            @{
                var currentLanguage = Languages.Current;
                var returnPath = ReturnPath;
            }
            <details class="lang-menu">
                <summary aria-label="@($"{L.T("Language")}: {currentLanguage.NativeName}")">
                    <span class="lang-globe" aria-hidden="true">🌐</span>
                    <span class="lang-current">@currentLanguage.ShortCode</span>
                </summary>
                <ul>
                    @foreach (var language in Languages.All)
                    {
                        var current = language == currentLanguage;
                        <li>
                            <a href="@LanguageLink(language, returnPath)" target="_top" lang="@language.Code" hreflang="@language.Code"
                               class="@(current ? "current" : null)" aria-current="@(current ? "true" : null)">@language.NativeName</a>
                        </li>
                    }
                </ul>
            </details>

            @* Opens the user guide (/help) in its own window, like the log. Last in the header, at the far right. *@
            <a class="key-button log-button help-button" href="help" target="gs-point3dweb-help"
               title="@L.T("Open the help in a separate window")" aria-label="@L.T("Help")"
               data-popup="width=1000,height=800">
                <Icon Kind="HelpCircle" Size="18" />
            </a>
        </div>
    </header>

    <div class="workspace">
    @{
        // One copy of the server list for this render (each AlpacaServers read copies it under a lock).
        var servers = ViewModel.AlpacaServers;
        var maxServers = ViewModel.MaxServers;
    }
    <aside class="sidebar" id="server-panel" @ondragenter="() => _hoverQuadrant = -1">
        <div class="sidebar-header">
            <h2>@L.T("Telescope Mounts")</h2>
            <span class="count" title="@L.T("Servers in the list")">
                @ViewModel.Count@(ViewModel.IsLicensed ? "" : $" / {FeatureKeyService.FreeMaxServers}")
            </span>
            @* Collapse / expand: handled in the browser (wwwroot/sidebar.js), which remembers the choice. Two
               buttons, one shown at a time by CSS, so each keeps its own label whatever Blazor re-renders. *@
            <button type="button" class="icon-btn sidebar-toggle collapse" data-sidebar-toggle="collapse"
                    aria-controls="server-panel" aria-expanded="true"
                    title="@L.T("Hide the server list")" aria-label="@L.T("Hide the server list")">
                <Icon Kind="ChevronDoubleLeft" Size="18" />
            </button>
            <button type="button" class="icon-btn sidebar-toggle expand" data-sidebar-toggle="expand"
                    aria-controls="server-panel" aria-expanded="false"
                    title="@L.T("Show the server list")" aria-label="@L.T("Show the server list")">
                <Icon Kind="ChevronDoubleRight" Size="18" />
            </button>
        </div>

        <div class="toolbar" role="toolbar" aria-label="@L.T("Server commands")">
            <button type="button" class="icon-btn" title="@L.T("Add")" aria-label="@L.T("Add")"
                    @onclick="() => ViewModel.AddCommand.Execute(null)">
                <Icon Kind="Plus" />
            </button>
            <button type="button" class="icon-btn" title="@L.T("Alpaca Discovery")" aria-label="@L.T("Alpaca Discovery")"
                    @onclick="() => ViewModel.DiscoveryCommand.ExecuteAsync(null)">
                <Icon Kind="Search" />
            </button>
            @if (ViewModel.ComSupported)
            {
                <button type="button" class="icon-btn" title="@L.T("ASCOM Drivers")" aria-label="@L.T("ASCOM Drivers")"
                        @onclick="() => ViewModel.AddComDriverCommand.ExecuteAsync(null)">
                    <Icon Kind="Telescope" />
                </button>
            }
            <button type="button" class="icon-btn @(ViewModel.SelectedAlpacaServer?.IsConnected == true ? "active" : null)"
                    title="@ConnectText" aria-label="@ConnectText"
                    disabled="@(ViewModel.IsBusy || ViewModel.SelectedAlpacaServer?.IsConnecting == true)"
                    @onclick="() => ViewModel.ConnectCommand.ExecuteAsync(null)">
                <Icon Kind="Connection" />
            </button>
            <button type="button" class="icon-btn" title="@L.T("Save")" aria-label="@L.T("Save")"
                    @onclick="() => ViewModel.SaveCommand.ExecuteAsync(null)">
                <Icon Kind="ContentSave" />
            </button>
            <span class="toolbar-spacer"></span>
            <button type="button" class="icon-btn danger" title="@L.T("Delete")" aria-label="@L.T("Delete")"
                    disabled="@(ViewModel.SelectedAlpacaServer is null)"
                    @onclick="() => ViewModel.DeleteCommand.ExecuteAsync(ViewModel.SelectedAlpacaServer)">
                <Icon Kind="Delete" />
            </button>
        </div>

        <nav class="server-nav" aria-label="@L.T("Telescope Mounts")">
            <ul class="server-list">
                @for (var position = 0; position < servers.Length; position++)
                {
                    var server = servers[position];
                    var allowed = position < maxServers;
                    <li>
                        <button type="button"
                                class="server-item @(server == ViewModel.SelectedAlpacaServer ? "selected" : null) @(allowed ? null : "locked")"
                                title="@(allowed ? ServerTooltip(server) : LockedTooltip(server))"
                                draggable="@(allowed ? "true" : "false")"
                                data-server-id="@server.IdGuid"
                                @ondragstart="() => ViewModel.StartDrag(server)"
                                @ondragend="() => { ViewModel.EndDrag(); _hoverQuadrant = -1; }"
                                @onclick="() => ViewModel.SelectServerCommand.Execute(server)"
                                @ondblclick="() => ViewModel.EditServerCommand.ExecuteAsync(server)"
                                @onkeydown="e => OnServerKeyDown(e, server)">
                            <span class="status @(server.IsConnected ? "connected" : null)"
                                  title="@(server.IsConnected ? L.T("Connected") : L.T("Not connected"))"></span>
                            @* Alpaca server or ASCOM COM driver: the project's logo. *@
                            <img class="kind" src="@ServerKind.Image(server)"
                                 alt="@ServerKind.Text(server)" title="@ServerKind.Text(server)" draggable="false" />
                            <span class="server-text">
                                <span class="name">@server.ServerName</span>
                                <span class="address">@ServerAddress(server)</span>
                            </span>
                            @if (!allowed)
                            {
                                <span class="lock" aria-label="@L.T("Needs a feature key")"><Icon Kind="Lock" Size="14" /></span>
                            }
                        </button>
                    </li>
                }
            </ul>
        </nav>

        <p class="sidebar-hint">
            @L.T("Drag a server onto a view to show its mount. Double-click a server (or press F2) to edit it.")
        </p>

        @* Donations for the project; just the heart while the list is collapsed. *@
        <a class="donate" href="https://www.gofundme.com/f/green-swamp-server" target="_blank" rel="noopener noreferrer"
           title="@L.T("Support the GSServer project on GoFundMe (opens in a new tab)")" aria-label="@L.T("Support on GoFundMe")">
            <Icon Kind="Heart" Size="18" />
            <span class="donate-text">@L.T("Support on GoFundMe")</span>
        </a>
    </aside>

    <section class="model-panel views-@ViewModel.ViewCount @(ViewModel.DragServer is not null ? "dragging" : null)" aria-label="@L.T("3D models")">
        @for (var i = 0; i < ViewModel.ViewCount; i++)
        {
            var index = i;
            var quadrant = ViewModel.Quadrants[index];
            @* Drop handlers live on the quadrant itself so a fast drag can't land before the
               overlay renders. dragleave isn't used: it fires when moving onto child elements. *@
            <div class="quadrant"
                 @ondragenter="() => _hoverQuadrant = index"
                 @ondragover:preventDefault
                 @ondrop="() => OnDrop(index)"
                 @ondrop:preventDefault>
                @if (quadrant.Server is { } lockedServer && !ViewModel.IsServerAllowed(lockedServer, servers))
                {
                    <div class="quadrant-empty">
                        <span class="empty-mark" aria-hidden="true"><Icon Kind="Lock" Size="22" /></span>
                        <p class="empty-title">@lockedServer.ServerName</p>
                        <p>@L.T("Needs a feature key (free version: {0} servers)", FeatureKeyService.FreeMaxServers)</p>
                    </div>
                }
                else if (quadrant.Server is { } server)
                {
                    <FlipCard @key="quadrant.Key" Flipped="quadrant.Flipped">
                        <Front>
                            <Model3DView @ref="_views[index]" Server="server"
                                         OnSettings="() => ViewModel.ToggleFlip(index)"
                                         OnClose="() => ViewModel.ClearQuadrant(index)"
                                         OnConnectionChanged="StateHasChanged"
                                         OnSettingsChanged="ViewModel.ServerSettingsChangedAsync" />
                        </Front>
                        <Back>
                            <ViewSettingsPanel Server="server" Showing="quadrant.Flipped"
                                               OnSaveCamera="() => SaveCameraAsync(index)"
                                               OnResetCamera="() => ResetCameraAsync(index)"
                                               OnClearCamera="() => ClearCameraAsync(index)"
                                               OnDone="() => ViewModel.ToggleFlip(index)"
                                               OnChanged="ViewModel.ServerSettingsChangedAsync" />
                        </Back>
                    </FlipCard>
                }
                else
                {
                    <div class="quadrant-empty">
                        <span class="empty-mark" aria-hidden="true"><Icon Kind="Connection" Size="22" /></span>
                        <p class="empty-title">@L.T("View {0}", index + 1)</p>
                        <p>@L.T("Drag a server here")</p>
                    </div>
                }

                @if (ViewModel.DragServer is not null)
                {
                    <div class="drop-zone @(_hoverQuadrant == index ? "over" : null)">
                        <span>@L.T("Show {0}", ViewModel.DragServer.ServerName)</span>
                    </div>
                }
            </div>
        }
    </section>
    </div>
</div>

@code {
    private int _hoverQuadrant = -1;

    protected override void OnAfterRender(bool firstRender)
    {
        // After the first interactive render (never during prerendering), so the dialog reaches the page.
        if (firstRender) _ = ViewModel.ShowStartupNoticeAsync();
    }

    /// <summary>Whether the top menu is unfolded in a narrow window (wide windows always show it).</summary>
    private bool _menuOpen;

    // ===== Stay on top =====

    private bool _onTop;
    private bool _onTopBusy;

    /// <summary>Why the last try didn't work (the box's tooltip), or null.</summary>
    private string? _onTopMessage;

    /// <summary>Remembered per tab, so a reload (or a reconnect) keeps the window on top and the box ticked.</summary>
    private const string OnTopKey = "gs-point3dweb-ontop";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !WindowPin.IsSupported) return;
        try
        {
            if (await JS.InvokeAsync<string?>("gsPoint3d.sessionGet", OnTopKey) == "1") await SetOnTopAsync(true, restoring: true);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>
    /// Puts this browser window on top of all others, or back to normal. The tab's title is briefly set to a
    /// unique text so the app can find its window among the desktop's (see <see cref="WindowPin"/>).
    /// </summary>
    /// <param name="restoring">
    /// Putting the remembered choice back after a reload. If the window can't be found then (e.g. the tab
    /// reloaded in the background), the choice is kept for the next try and no warning shows: the window may
    /// well still be on top, as Windows keeps that across a reload.
    /// </param>
    private async Task SetOnTopAsync(bool on, bool restoring = false)
    {
        if (_onTopBusy) return;
        var previous = _onTop;
        // Shown straight away; put back below if it didn't work (the box then visibly changes back).
        _onTop = on;
        _onTopBusy = true;
        _onTopMessage = null;
        StateHasChanged();

        var token = "GS Point3D Web " + Guid.NewGuid().ToString("N")[..12];
        string? title = null;
        var done = false;
        try
        {
            title = await JS.InvokeAsync<string>("gsPoint3d.setTitle", token);
            done = await WindowPin.SetTopMostAsync(token, on);
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (Exception ex)
        {
            AppLog.For(nameof(Home)).LogWarning(ex, "Stay on top failed: {Error}", ex.Message);
        }
        finally
        {
            if (title is not null)
            {
                try { await JS.InvokeVoidAsync("gsPoint3d.setTitle", title); }
                catch (JSDisconnectedException) { }
                catch (JSException ex) { AppLog.For(nameof(Home)).LogWarning(ex, "Couldn't put the page title back: {Error}", ex.Message); }
            }
            _onTopBusy = false;
        }

        if (!done)
        {
            // The window is as it was: show that, not a guess.
            _onTop = previous;
            if (restoring)
            {
                StateHasChanged();
                return; // keep the remembered choice; no warning (see above)
            }
            _onTopMessage = on
                ? L.T("Couldn't keep the window on top: this only works in a browser on the computer running GS Point3D Web.")
                : L.T("Couldn't change the window: this only works in a browser on the computer running GS Point3D Web.");
        }
        try
        {
            await JS.InvokeVoidAsync("gsPoint3d.sessionSet", OnTopKey, _onTop ? "1" : null);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            AppLog.For(nameof(Home)).LogWarning(ex, "Couldn't remember the on-top choice: {Error}", ex.Message);
        }
        StateHasChanged();
    }

    /// <summary>The 3D view in each quadrant, to read or set its camera.</summary>
    private readonly Model3DView?[] _views = new Model3DView?[SettingsService.QuadrantCount];

    /// <summary>Saves the quadrant's current camera to its server's settings.</summary>
    private async Task SaveCameraAsync(int index)
    {
        if (ViewModel.Quadrants[index].Server is not { } server || _views[index] is not { } view) return;
        var camera = await view.GetCameraAsync();
        if (camera is null) return;
        server.Camera = camera;
        await ViewModel.ServerSettingsChangedAsync();
    }

    /// <summary>Moves the quadrant's camera back to its server's saved view.</summary>
    private Task ResetCameraAsync(int index) => _views[index]?.ResetCameraAsync() ?? Task.CompletedTask;

    /// <summary>Forgets the server's saved view and returns this quadrant to the default camera.</summary>
    private async Task ClearCameraAsync(int index)
    {
        if (ViewModel.Quadrants[index].Server is not { } server) return;
        server.Camera = null;
        await ViewModel.ServerSettingsChangedAsync();
        await ResetCameraAsync(index);
    }

    private void OnDrop(int index)
    {
        _hoverQuadrant = -1;
        ViewModel.DropOnQuadrant(index);
    }

    private string ConnectText => ViewModel.SelectedAlpacaServer?.IsConnected == true ? L.T("Disconnect") : L.T("Connect");

    private static string ViewsTitle(int count, bool locked)
        => locked ? L.T("{0} views need a feature key", count)
            : count == 1 ? L.T("Show 1 3D view") : L.T("Show {0} 3D views", count);

    private static string LockedTooltip(AlpacaServer server)
        => $"{server.ServerName}\n{server.Url}\n{L.T("Needs a feature key (free version: {0} servers)", FeatureKeyService.FreeMaxServers)}";

    /// <summary>
    /// This page's path and query, escaped for the redirect. It includes the app's base path, so the
    /// redirect comes back here even when the app is hosted under a sub-path.
    /// </summary>
    private string ReturnPath => Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);

    /// <summary>The address that saves a language in the culture cookie and comes back to this page.</summary>
    private static string LanguageLink(Language language, string returnPath)
        => $"culture/set?culture={Uri.EscapeDataString(language.Code)}&redirectUri={returnPath}";

    private int ConnectedCount => ViewModel.AlpacaServers.Count(s => s.IsConnected);

    // The name leads: the collapsed server strip shows only the icons.
    private static string ServerTooltip(AlpacaServer server) => $"{server.ServerName}\n{server.Url}\n{L.T("Double-click (or F2) to edit")}";

    /// <summary>Short address for the list: host:port and device number.</summary>
    private static string ServerAddress(AlpacaServer server)
    {
        if (server.ProgId is { } progId) return progId; // the ASCOM icon says what it is
        if (!Uri.TryCreate(server.Url, UriKind.Absolute, out var uri)) return server.Url;
        var device = uri.Segments.LastOrDefault()?.Trim('/');
        return int.TryParse(device, out var number)
            ? $"{uri.Authority} · {L.T("telescope {0}", number)}"
            : uri.Authority;
    }

    private Task OnServerKeyDown(KeyboardEventArgs e, AlpacaServer server)
        => e.Key == "F2" ? ViewModel.EditServerCommand.ExecuteAsync(server) : Task.CompletedTask;
}
