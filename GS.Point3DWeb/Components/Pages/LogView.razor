@page "/log"
@using Microsoft.Extensions.Logging
@inherits LocalizedComponentBase
@implements IDisposable

@* The log viewer, opened in its own window from the Home page's "View Log" button. Shows the end of the
   newest log file; with Follow on it checks every couple of seconds and adds only the new lines, and stays
   scrolled to the newest one (the scroll box is laid out bottom-up, so no script is needed). *@

<PageTitle>@L.T("Log") · GS Point3D Web</PageTitle>

<div class="log-page">
    <header class="log-header">
        <div class="log-title">
            <h1>@L.T("Log")</h1>
            @if (_file is not null)
            {
                <span class="log-file" title="@_file.FullName">@_file.Name</span>
                <span class="log-meta">@MetaText</span>
            }
        </div>

        <div class="log-tools">
            <label class="log-option" title="@L.T("Show only warnings and errors")">
                <input type="checkbox" @bind="_problemsOnly" />
                <span>@L.T("Warnings and errors only")</span>
            </label>
            <label class="log-option" title="@L.T("Re-read the log as it grows and keep the newest line in view")">
                <input type="checkbox" @bind="Follow" />
                <span>@L.T("Follow")</span>
            </label>
            <button type="button" class="log-button" @onclick="Reload">@L.T("Refresh")</button>
            @if (_file is not null)
            {
                <a class="log-button" href="log/file" download="@_file.Name">@L.T("Download")</a>
            }
        </div>
    </header>

    @if (_problem is not null)
    {
        <p class="log-note error">@_problem</p>
    }
    else if (_file is null)
    {
        <p class="log-note">@L.T("No log file yet. It is created in {0} when the app first writes to it.", AppLog.Folder)</p>
    }
    else if (_truncated)
    {
        <p class="log-note">@L.T("Showing the last {0} of the file; download it for the whole log.", SizeText(MaxBytes))</p>
    }

    <div class="log-scroll">
        <pre class="log-text">@foreach (var line in VisibleLines)
{<span @key="line.Offset" class="@line.Css">@line.Text</span>@("\n")}</pre>
    </div>
</div>

@code {
    // How much of the log to keep on screen: enough for a long session, small enough to render quickly.
    private const int MaxBytes = 512 * 1024;
    private static readonly TimeSpan FollowInterval = TimeSpan.FromSeconds(2);

    private FileInfo? _file;
    private long _length;         // the file's length at the last read
    private long _next = -1;      // where the next read starts (-1: read the end of the file afresh)
    private string? _lastEntry;   // time of the newest entry shown
    private bool _truncated;
    private string? _problem;
    private bool _problemsOnly;
    private readonly List<LogLine> _lines = [];
    private long _shownBytes;
    private string _css = "inf";  // the level of the entry the next line belongs to
    private bool _inProblem;

    private Timer? _timer;
    private bool _follow = true;
    private volatile bool _disposed;
    private int _ticking;         // 1 while a timer tick is reading (ticks don't overlap)

    /// <param name="Offset">Where the line starts in the file: a stable key for rendering.</param>
    /// <param name="Bytes">Its size in the file, to keep what is shown within <see cref="MaxBytes"/>.</param>
    private readonly record struct LogLine(long Offset, int Bytes, string Text, string Css, bool Problem);

    /// <summary>The file's size and the time of its newest entry.</summary>
    private string MetaText => _lastEntry is { } last
        ? $"{SizeText(_length)} · {L.T("Updated {0}", last)}"
        : SizeText(_length);

    private IEnumerable<LogLine> VisibleLines => _problemsOnly ? _lines.Where(l => l.Problem) : _lines;

    private bool Follow
    {
        get => _follow;
        set
        {
            _follow = value;
            if (value) Update();
            UpdateTimer();
        }
    }

    protected override void OnInitialized()
    {
        Update();
        UpdateTimer();
    }

    private void UpdateTimer()
    {
        if (_follow && !_disposed) _timer ??= new Timer(_ => Tick(), null, FollowInterval, FollowInterval);
        else
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    /// <summary>A Follow tick: adds new lines on the page's thread. Safe after the window has closed.</summary>
    private async void Tick()
    {
        if (_disposed || Interlocked.Exchange(ref _ticking, 1) == 1) return;
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                if (Update()) StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // the window closed (or its connection dropped) while this tick was queued
        }
        catch (Exception ex)
        {
            AppLog.For("LogView").LogWarning(ex, "Log viewer update failed");
        }
        finally
        {
            Interlocked.Exchange(ref _ticking, 0);
        }
    }

    /// <summary>Refresh: reads the end of the newest log afresh.</summary>
    private void Reload()
    {
        _next = -1;
        Update();
    }

    /// <summary>
    /// Reads what was added since the last read (or the end of the file afresh, if a newer file was started,
    /// the file started over, or nothing is shown yet). Returns whether anything changed.
    /// </summary>
    private bool Update()
    {
        try
        {
            _problem = null;
            var latest = LogFiles.Latest();
            if (latest is null)
            {
                var hadFile = _file is not null;
                _file = null;
                Clear();
                return hadFile;
            }
            if (latest.FullName != _file?.FullName) _next = -1;
            _file = latest;

            var chunk = LogFiles.Read(latest, _next, MaxBytes);
            var changed = chunk.Length != _length || chunk.FromStart;
            _length = chunk.Length;
            _next = chunk.End;
            if (chunk.FromStart)
            {
                Clear();
                _truncated = chunk.Truncated;
            }
            Append(chunk.Lines);
            return changed;
        }
        catch (Exception ex)
        {
            _problem = L.T("Could not read the log: {0}", ex.Message);
            return true;
        }
    }

    private void Clear()
    {
        _lines.Clear();
        _shownBytes = 0;
        _truncated = false;
        _lastEntry = null;
        _css = "inf";
        _inProblem = false;
    }

    /// <summary>
    /// Adds lines, coloring each by its entry's level: lines that don't start an entry (an exception's stack
    /// trace) take the level of the entry they belong to. Drops the oldest lines beyond <see cref="MaxBytes"/>.
    /// </summary>
    private void Append(IReadOnlyList<LogFiles.Line> lines)
    {
        foreach (var line in lines)
        {
            if (LevelOf(line.Text) is { } level)
            {
                _css = level;
                _inProblem = level is "wrn" or "err" or "ftl";
                _lastEntry = line.Text.Substring(11, 8); // HH:mm:ss
            }
            var bytes = System.Text.Encoding.UTF8.GetByteCount(line.Text) + 1;
            _lines.Add(new LogLine(line.Offset, bytes, line.Text, _css, _inProblem));
            _shownBytes += bytes;
        }

        var drop = 0;
        while (_shownBytes > MaxBytes && drop < _lines.Count)
            _shownBytes -= _lines[drop++].Bytes;
        if (drop > 0)
        {
            _lines.RemoveRange(0, drop);
            _truncated = true;
        }
    }

    /// <summary>The level of a line that starts an entry ("2026-11-13 06:11:08.931 [INF] …"), else null.</summary>
    private static string? LevelOf(string line)
    {
        // The timestamp is 23 characters, then a space and the level in brackets.
        if (line.Length < 29 || line[24] != '[' || line[28] != ']' || !char.IsDigit(line[0])) return null;
        return line.Substring(25, 3).ToLowerInvariant() switch
        {
            "vrb" or "dbg" => "dbg",
            "inf" => "inf",
            "wrn" => "wrn",
            "err" => "err",
            "ftl" => "ftl",
            _ => null
        };
    }

    private static string SizeText(long bytes)
        => bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024):0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        _timer = null;
    }
}
