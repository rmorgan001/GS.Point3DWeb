@inherits MvvmComponentBase<Model3DViewModel>
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="model3d" aria-label="@L.T("3D model")">
    <header class="model3d-header">
        <span class="conn @(Server?.IsConnected == true ? "connected" : null)"
              title="@(Server?.IsConnected == true ? L.T("Connected") : L.T("Not connected"))"></span>
        @if (Server is not null)
        {
            @* Alpaca server or ASCOM COM driver: the same logo as in the server list. *@
            <img class="kind" src="@ServerKind.Image(Server)" alt="@ServerKind.Text(Server)" title="@ServerKind.Text(Server)"
                 draggable="false" />
        }
        <div class="titles">
            <h2 title="@Server?.Url">@ViewModel.DeviceName</h2>
            @if (Server is not null)
            {
                <span class="mount-tag" title="@L.T("Model and mount type")">
                    @ViewModel.ModelTitle · @Model3D.GetDisplayName(Server.AlignmentMode)
                </span>
            }
        </div>
        @if (OnSettings.HasDelegate)
        {
            <button type="button" class="icon-btn" title="@L.T("View settings")" aria-label="@L.T("View settings")"
                    @onclick="OnSettings">
                <Icon Kind="Cog" Size="18" />
            </button>
        }
        @if (OnClose.HasDelegate)
        {
            <button type="button" class="icon-btn close" title="@L.T("Remove from this view")" aria-label="@L.T("Remove from this view")"
                    @onclick="OnClose">
                <Icon Kind="Close" Size="18" />
            </button>
        }
    </header>

    <div class="viewport">
        <canvas @ref="_canvas" class="render-canvas"></canvas>

        @if (IsGrid)
        {
            @* Grid layout: every coordinate, and the mount state once connected, in one panel on the chosen edge of
               the scene (down the left or right, across the top or bottom). The model is shifted into the space
               beside it (setInset), so the panel never covers it. *@
            var connected = Server?.IsConnected == true;
            <aside class="coord-panel pos-@GridSide @(IsHorizontalGrid ? "horizontal" : null)" @ref="_gridPanel"
                   aria-label="@L.T("Mount coordinates")">
                <header class="cp-head">
                    <span class="cp-live @(connected ? "on" : null)">
                        <span class="dot" aria-hidden="true"></span>@(connected ? L.T("Live") : L.T("Offline"))
                    </span>
                    @if (Server is not null)
                    {
                        @ConnectButton(Server, iconOnly: true)
                    }
                </header>

                @if (ShownCoordinates().Any())
                {
                    <dl class="cp-rows">
                        @foreach (var item in ShownCoordinates())
                        {
                            <div class="cp-row @(item.IsRa ? "ra" : null)" title="@item.Title" @ondblclick="() => OnCoordinateDoubleClick(item)">
                                <dt>@item.Label</dt><dd>@item.Value</dd>
                            </div>
                        }
                    </dl>
                }

                @* The rest of what devicestate reports; only while connected (Status is null otherwise). *@
                @if (Server?.ShowMountState != false && ViewModel.Status is { } gridStatus)
                {
                    <div class="cp-section" role="group" aria-label="@L.T("Mount state")">
                        <div class="cp-flags">
                            @StateFlags(gridStatus)
                        </div>
                        @if (gridStatus.SideOfPier is not null || gridStatus.UtcDate is not null || gridStatus.TimeStamp is not null)
                        {
                            <dl class="cp-rows cp-meta">
                                @if (gridStatus.SideOfPier is { } gridSide)
                                {
                                    <div class="cp-row"><dt>@L.T("Pier")</dt><dd>@PierText(gridSide)</dd></div>
                                }
                                @if (gridStatus.UtcDate is { } gridUtc)
                                {
                                    <div class="cp-row" title="@L.T("The mount's UTC date and time")">
                                        <dt>UTC</dt>
                                        <dd class="cp-stack">
                                            <span>@gridUtc.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span>
                                            <small>@gridUtc.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</small>
                                        </dd>
                                    </div>
                                }
                                @if (gridStatus.TimeStamp is { } stamp)
                                {
                                    <div class="cp-row" title="@L.T("When the server read the mount's state")">
                                        <dt>@L.T("Read at")</dt><dd>@StampText(stamp)</dd>
                                    </div>
                                }
                            </dl>
                        }
                    </div>
                }
            </aside>
        }
        else if (IsNone)
        {
            @* Nothing but Connect / Disconnect, in the top-left corner. *@
            @if (Server is not null)
            {
                <div class="coords">
                    @ConnectButton(Server)
                </div>
            }
        }
        else
        {
            @* Coordinates float over the top of the scene; which ones show is chosen on the back of the card. *@
            <div class="coords" aria-label="@L.T("Mount coordinates")">
                @foreach (var item in ShownCoordinates())
                {
                    <span class="coord @(item.IsRa ? "ra" : null)" title="@item.Title" @ondblclick="() => OnCoordinateDoubleClick(item)">
                        <span class="label">@item.Label</span><span class="value">@item.Value</span>
                    </span>
                }
                @if (Server is not null)
                {
                    @ConnectButton(Server)
                }
            </div>

            @* The rest of what devicestate reports, along the bottom of the scene: a readout only, so mouse and
               touch go through it to the model. A flag that is on has a filled dot, one that is off a hollow one. *@
            @if (Server?.ShowMountState != false && ViewModel.Status is { } status)
            {
                <div class="mount-state @(ShowHeading ? "beside-heading" : null)" role="group" aria-label="@L.T("Mount state")">
                    @StateFlags(status)
                    @if (status.SideOfPier is { } side)
                    {
                        <span class="chip pier">
                            <span class="label">@L.T("Pier")</span>
                            <span class="value">@PierText(side)</span>
                        </span>
                    }
                    @if (status.UtcDate is { } utc)
                    {
                        <span class="chip utc">
                            <span class="label">UTC</span><span class="value">@utc.ToString("yyyy-MM-dd HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </span>
                    }
                </div>
            }
        }

        @if (ShowHeading)
        {
            @* Which way the camera faces: the viewer (model3d.js) turns the needle and writes the bearing as the
               camera moves, so nothing here re-renders with it. The red tip points north. Clicking it turns the
               view to face north; the viewer handles the click too, so it answers without a trip to the server. *@
            <button type="button" class="heading at-@HeadingCorner" @ref="_heading"
                    title="@L.T("Which way the camera is facing (compass bearing); the red tip points north. Click to turn the view to face north.")"
                    aria-label="@L.T("Which way the camera is facing (compass bearing); the red tip points north. Click to turn the view to face north.")">
                <span class="heading-dial" aria-hidden="true"><span class="heading-needle"></span></span>
                <span class="heading-value"></span>
            </button>
        }

        @if (_overlay is not null)
        {
            <div class="overlay @(_overlayIsError ? "error" : null)">
                <span class="overlay-mark" aria-hidden="true"></span>
                <p>@_overlay</p>
            </div>
        }
    </div>

    <footer class="model3d-status">
        <span class="axes" title="@L.T("Mount axes (X, Y) and tilt (Z), as in GSServer")">
            <span><span class="label">X</span> @ViewModel.PrimaryAxis.ToString("F4")°</span>
            <span><span class="label">Y</span> @ViewModel.SecondaryAxis.ToString("F4")°</span>
            <span><span class="label">Z</span> @ViewModel.Tilt.ToString("F2")°</span>
        </span>
        <span class="status-text" title="@(ViewModel.StatusDetail ?? ViewModel.StatusText)">@ViewModel.StatusText</span>
        <RunClock Elapsed="() => ViewModel.RunningTime" IsRunning="() => ViewModel.IsRunningClockOn" />
    </footer>
</section>

@code {
    /// <summary>The server to connect to and show.</summary>
    [Parameter] public AlpacaServer? Server { get; set; }

    /// <summary>Shows a settings button (flips the quadrant to its view settings) when set.</summary>
    [Parameter] public EventCallback OnSettings { get; set; }

    /// <summary>Shows a close button when set.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after the view (connecting on open, or polling) changes the server's connection state.</summary>
    [Parameter] public EventCallback OnConnectionChanged { get; set; }

    /// <summary>Raised after a per-server setting changes from this view (Ra units toggled), so the owner can save.</summary>
    [Parameter] public EventCallback OnSettingsChanged { get; set; }

    /// <summary>
    /// One on / off item of the mount state; nothing if the mount didn't report it. Screen readers get the
    /// whole "Tracking: yes" / "Tracking: no" rather than the label alone.
    /// </summary>
    /// <param name="kind">The colour when lit: "on" (green) or "busy" (yellow, the mount isn't free).</param>
    private RenderFragment StateFlag(bool? value, string label, string kind) => @<text>
        @if (value is { } on)
        {
            <span class="chip flag @(on ? kind : null)">
                <span class="dot" aria-hidden="true"></span><span aria-hidden="true">@label</span>
                <span class="visually-hidden">@(on ? L.T("{0}: yes", label) : L.T("{0}: no", label))</span>
            </span>
        }
    </text>;

    private bool IsGrid => Server?.CoordinatesLayout == CoordinatesLayout.Grid;

    /// <summary>No coordinates or mount state on the front: only the connection button.</summary>
    private bool IsNone => Server?.CoordinatesLayout == CoordinatesLayout.None;

    /// <summary>The grid's edge as the CSS class and the viewer know it: left, right, top or bottom.</summary>
    private string GridSide => (Server?.GridPosition ?? GridPosition.Left).ToString().ToLowerInvariant();

    /// <summary>A grid across the top or bottom: its items run in a row rather than down a column.</summary>
    private bool IsHorizontalGrid => Server?.GridPosition is GridPosition.Top or GridPosition.Bottom;

    /// <summary>One coordinate on the front: the same list for the chips and the grid.</summary>
    private sealed record CoordinateItem(string Label, string Value, string? Title = null, bool IsRa = false);

    /// <summary>The coordinates chosen on the back of the card, in order.</summary>
    private IEnumerable<CoordinateItem> ShownCoordinates()
    {
        var server = Server;
        if (server?.ShowRa != false)
            yield return new("Ra", ViewModel.Ra, L.T("Double-click to switch between hours and degrees"), IsRa: true);
        if (server?.ShowDec != false) yield return new("Dec", ViewModel.Dec);
        if (server?.ShowAz != false) yield return new("Az", ViewModel.Az);
        if (server?.ShowAlt != false) yield return new("Alt", ViewModel.Alt);
        if (server?.ShowLha != false) yield return new("Lha", ViewModel.Lha);
        if (server?.ShowLst != false) yield return new("Lst", ViewModel.Lst, L.T("Local sidereal time"));
    }

    /// <summary>Double-clicking Ra switches it between hours and degrees.</summary>
    private Task OnCoordinateDoubleClick(CoordinateItem item) => item.IsRa ? ToggleRaUnitsAsync() : Task.CompletedTask;

    /// <summary>The five on / off items of the mount state, for the chip strip and the grid alike.</summary>
    private RenderFragment StateFlags(Model3DViewModel.MountStatus status) => @<text>
        @StateFlag(status.Tracking, L.T("Tracking"), "on")
        @StateFlag(status.Slewing, L.T("Slewing"), "busy")
        @StateFlag(status.AtPark, L.T("Parked"), "busy")
        @StateFlag(status.AtHome, L.T("At home"), "on")
        @StateFlag(status.IsPulseGuiding, L.T("Guiding"), "on")
    </text>;

    private static string PierText(int side) => side switch { 0 => L.T("East"), 1 => L.T("West"), _ => L.T("Unknown") };

    /// <summary>The server's read time (UTC, see MountStatus.From) in this computer's time.</summary>
    private static string StampText(DateTime stampUtc)
        => stampUtc.ToLocalTime().ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// Connect / Disconnect for the server: with its wording at the end of the coordinate chips, just the icon
    /// next to the grid's Live pill (the tooltip and screen readers still say what it does).
    /// </summary>
    private RenderFragment ConnectButton(AlpacaServer server, bool iconOnly = false) => __builder =>
    {
        var connected = server.IsConnected;
        var text = ViewModel.IsConnectionBusy
            ? (connected ? L.T("Disconnecting…") : L.T("Connecting…"))
            : (connected ? L.T("Disconnect") : L.T("Connect"));
        <button type="button" class="connect-btn @(connected ? "connected" : null) @(iconOnly ? "icon-only" : null)"
                disabled="@ViewModel.IsConnectionBusy"
                title="@(connected ? L.T("Disconnect from {0}", server.ServerName) : L.T("Connect to {0}", server.ServerName))"
                aria-label="@(iconOnly ? text : null)"
                @onclick="ViewModel.ToggleConnectionAsync">
            <Icon Kind="Connection" Size="14" />
            @if (!iconOnly)
            {
                <span>@text</span>
            }
        </button>
    };

    private bool ShowHeading => Server?.ShowHeading == true;

    /// <summary>The letter size as model3d.js knows it: small, medium, large or xlarge.</summary>
    private string CardinalSizeKey => (Server?.CardinalSize ?? CardinalSize.Large).ToString().ToLowerInvariant();

    /// <summary>The compass readout's corner: bottom right, unless the grid panel is on that edge.</summary>
    private string HeadingCorner => IsGrid
        ? Server?.GridPosition switch { GridPosition.Right => "bottom-left", GridPosition.Bottom => "top-right", _ => "bottom-right" }
        : "bottom-right";

    private ElementReference _heading;

    // Whether the viewer has the compass readout: null = not told yet.
    private bool? _sentHeading;

    /// <summary>Hands the compass readout to the viewer (or takes it away), so it follows the camera.</summary>
    private async Task SyncHeadingAsync()
    {
        if (_disposed || _module is null || _viewer is null) return;
        var show = ShowHeading;
        if (_sentHeading == show) return;
        try
        {
            await _module.InvokeVoidAsync("setHeadingElement", _viewer, show ? _heading : null);
            _sentHeading = show;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex) when (ex is JSException or ObjectDisposedException or InvalidOperationException)
        {
            _sentHeading = null; // tried again on the next render
        }
    }

    private ElementReference _gridPanel;

    // The panel the viewer last kept the model clear of: its edge, "" for none, null = not told yet.
    private string? _sentGridInset;

    /// <summary>Tells the viewer about the grid panel (its edge, or its going), so the model moves beside it.</summary>
    private async Task SyncInsetAsync()
    {
        if (_disposed || _module is null || _viewer is null) return;
        var side = IsGrid ? GridSide : "";
        if (_sentGridInset == side) return;
        try
        {
            await _module.InvokeVoidAsync("setInset", _viewer, IsGrid ? _gridPanel : null, side);
            _sentGridInset = side; // only once the viewer has it; a failed call is tried again on the next render
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex) when (ex is JSException or ObjectDisposedException or InvalidOperationException)
        {
            // The viewer being torn down, or a browser-side error: the model just stays where it is.
            _sentGridInset = null;
        }
    }

    private Task ToggleRaUnitsAsync()
    {
        if (Server is null) return Task.CompletedTask;
        Server.RaInDegrees = !Server.RaInDegrees;
        return OnSettingsChanged.InvokeAsync();
    }

    /// <summary>Calls a viewer function (model3d.js) with the viewer and one argument.</summary>
    private async Task CallViewerAsync(string function, object? argument)
    {
        if (_module is null || _viewer is null) return;
        try
        {
            await _module.InvokeVoidAsync(function, _viewer, argument);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>The camera as it is now in this view (to save it), or null if the viewer isn't ready.</summary>
    public async Task<CameraView?> GetCameraAsync()
    {
        if (_module is null || _viewer is null) return null;
        try
        {
            return await _module.InvokeAsync<CameraView>("getCamera", _viewer);
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
    }

    /// <summary>Moves this view's camera back to the server's saved view (or the default).</summary>
    public Task ResetCameraAsync() => CallViewerAsync("setCamera", Server?.Camera);

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _viewer;
    private string? _overlay = L.T("Initializing…");
    private bool _overlayIsError;
    private bool _modelLoaded;
    private int _rotationPending;
    // The pose last sent to the browser, so an unchanged one isn't sent again on every poll. Written on the
    // renderer and read on the poll thread, so under a lock: four doubles aren't read or written in one step.
    private (double X, double Y, double Z, double YCentre)? _sentPose;
    private readonly Lock _sentPoseLock = new();
    private AlpacaServer? _watchedServer;
    private string? _loadedModelKey;
    private bool? _northCompass;

    // Set when the view is removed. Start-up awaits the browser several times, so the view can be
    // removed part-way through; start-up then tears down what it made instead of starting to poll.
    private bool _disposed;

    protected override void OnParametersSet()
    {
        ViewModel.Server = Server;
        if (Server is not null) ViewModel.DeviceName = Server.ServerName;

        if (!ReferenceEquals(_watchedServer, Server))
        {
            if (_watchedServer is not null) _watchedServer.PropertyChanged -= OnServerPropertyChanged;
            _watchedServer = Server;
            if (_watchedServer is not null) _watchedServer.PropertyChanged += OnServerPropertyChanged;
            // A view moved to another server turns north with that server's other views from now on.
            _ = CallViewerAsync("setServerKey", Server?.IdGuid);
        }
    }

    /// <summary>Applies edits to the server (model, offsets, name) while it is being shown.</summary>
    private void OnServerPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        switch (e.PropertyName)
        {
            case nameof(AlpacaServer.PolarMode)
                or nameof(AlpacaServer.AssemblySupport)
                or nameof(AlpacaServer.AssemblyMount) or nameof(AlpacaServer.AssemblyOta)
                or nameof(AlpacaServer.AssemblyOtaSize):
                _ = InvokeAsync(async () =>
                {
                    await ReloadModelIfChangedAsync();
                    StateHasChanged();
                });
                break;
            case nameof(AlpacaServer.AlignmentMode) or nameof(AlpacaServer.Latitude):
                // Read from the mount after connecting: may change the model file, tilt and compass.
                _ = InvokeAsync(async () =>
                {
                    await UpdateCompassAsync();
                    await ReloadModelIfChangedAsync();
                    // The assembled model isn't reloaded for a new latitude: aim the camera for it instead.
                    if (ViewModel.ShowsAssembly) await CallViewerAsync("recentre", ViewModel.MountInfo);
                    await ApplyCurrentRotationAsync();
                    StateHasChanged();
                });
                break;
            case nameof(AlpacaServer.RaOffset) or nameof(AlpacaServer.DecOffset):
                _ = InvokeAsync(ApplyCurrentRotationAsync);
                break;
            case nameof(AlpacaServer.ModelColor):
                _ = InvokeAsync(() => CallViewerAsync("setModelColor", ViewModel.ModelColor));
                break;
            case nameof(AlpacaServer.Background):
                _ = InvokeAsync(() => CallViewerAsync("setBackground", ViewModel.BackgroundUrl));
                break;
            case nameof(AlpacaServer.ShowGrid):
                _ = InvokeAsync(() => CallViewerAsync("setGrid", Server?.ShowGrid != false));
                break;
            case nameof(AlpacaServer.ShowCardinals):
                _ = InvokeAsync(() => CallViewerAsync("setCardinals", Server?.ShowCardinals == true));
                break;
            case nameof(AlpacaServer.CardinalSize):
                _ = InvokeAsync(() => CallViewerAsync("setCardinalSize", CardinalSizeKey));
                break;
            case nameof(AlpacaServer.RaInDegrees):
                ViewModel.RefreshRa();
                break;
            case nameof(AlpacaServer.Url):
                // The logo (Alpaca or ASCOM) and the name's tooltip follow an edited address.
                _ = InvokeAsync(StateHasChanged);
                break;
            case nameof(AlpacaServer.ServerName):
                ViewModel.DeviceName = Server?.ServerName ?? ViewModel.DeviceName;
                break;
            case nameof(AlpacaServer.IsConnecting):
                // A connect from elsewhere (toolbar, a drop): the button shows "Connecting…".
                _ = InvokeAsync(StateHasChanged);
                break;
            case nameof(AlpacaServer.IsConnected):
                // Whoever changed it (toolbar, another view, a lost connection), the page's dots,
                // count and buttons follow the server's real state. The running clock starts or pauses with it,
                // and the mount state strip goes on a disconnect.
                ViewModel.OnServerConnectionChanged();
                _ = InvokeAsync(StateHasChanged);
                _ = InvokeAsync(() => OnConnectionChanged.InvokeAsync());
                break;
            case nameof(AlpacaServer.ShowRa) or nameof(AlpacaServer.ShowDec)
                or nameof(AlpacaServer.ShowAz) or nameof(AlpacaServer.ShowAlt)
                or nameof(AlpacaServer.ShowLha) or nameof(AlpacaServer.ShowLst)
                or nameof(AlpacaServer.ShowMountState) or nameof(AlpacaServer.CoordinatesLayout)
                or nameof(AlpacaServer.GridPosition) or nameof(AlpacaServer.ShowHeading):
                _ = InvokeAsync(StateHasChanged);
                break;
        }
    }

    /// <summary>The model file and the pier (alignment mode, latitude) it was loaded with.</summary>
    private string ModelKey => ViewModel.ModelKey;

    private Task ReloadModelIfChangedAsync()
        => ModelKey == _loadedModelKey ? Task.CompletedTask : LoadModelAsync();

    private async Task UpdateCompassAsync()
    {
        if (_module is null || _viewer is null) return;
        var north = ViewModel.UseNorthCompass;
        if (_northCompass == north) return;
        _northCompass = north;
        try
        {
            await _module.InvokeVoidAsync("setHemisphere", _viewer, north);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadModelAsync()
    {
        if (_module is null || _viewer is null) return;
        string? key = null;
        try
        {
            _modelLoaded = false;
            ViewModel.StatusText = L.T("Loading {0} model…", ViewModel.ModelName);
            // Set before the load, so a second change while it runs doesn't start the same load again.
            key = _loadedModelKey = ModelKey;
            // A model is several MB: on a slow link or a Raspberry Pi it can take longer than the usual
            // JS call limit, so it gets its own.
            var result = await _module.InvokeAsync<string>("loadModel", ModelLoadTimeout, [_viewer, ViewModel.ModelUrl, ViewModel.MountInfo]);
            if (result == "Superseded") return; // a newer load replaced this one (model3d.js)
            if (result.Contains("Error", StringComparison.OrdinalIgnoreCase))
            {
                ViewModel.StatusText = L.T("Failed to load model: {0}", result);
                LoadFailed(key);
                return;
            }

            _loadFailedAt = null;
            _modelLoaded = true;
            ViewModel.StatusText = L.T("Telescope loaded: {0}", ViewModel.ModelName);
            await ApplyCurrentRotationAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            ViewModel.StatusText = L.T("Failed to load model: {0}", ex.Message);
            LoadFailed(key);
        }
        catch (OperationCanceledException ex)
        {
            // The load took longer than ModelLoadTimeout: tried again later, like any other failed load.
            ViewModel.StatusText = L.T("Failed to load model: {0}", ex.Message);
            LoadFailed(key);
        }
    }

    private static readonly TimeSpan ModelLoadTimeout = TimeSpan.FromMinutes(2);

    // When the last model load failed (null = it didn't). A failed load (e.g. a network hiccup fetching
    // the .obj) is tried again on a later update, at most every RetryLoadAfter, rather than never.
    private DateTime? _loadFailedAt;
    private static readonly TimeSpan RetryLoadAfter = TimeSpan.FromSeconds(10);

    private void LoadFailed(string? key)
    {
        // Forget the failed model, unless a newer load has started meanwhile.
        if (key is not null && _loadedModelKey == key) _loadedModelKey = null;
        _loadFailedAt = DateTime.UtcNow;
    }

    private Task ApplyCurrentRotationAsync() => _modelLoaded ? SetPoseAsync() : Task.CompletedTask;

    private void OnVmConnectionChanged() => _ = InvokeAsync(() => OnConnectionChanged.InvokeAsync());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // The grid panel comes and goes with the layout setting: the model follows it.
            await SyncInsetAsync();
            await SyncHeadingAsync();
            return;
        }

        try
        {
            ViewModel.StatusText = L.T("Initializing 3D viewer…");
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./model3d/model3d.js");
            if (_disposed)
            {
                await TearDownViewerAsync();
                return;
            }
            _viewer = await _module.InvokeAsync<IJSObjectReference>("create", _canvas, new
            {
                primaryColor = ViewModel.ModelColor,
                background = ViewModel.BackgroundUrl,
                grid = Server?.ShowGrid != false,
                cardinals = Server?.ShowCardinals == true,
                cardinalSize = CardinalSizeKey,
                serverKey = Server?.IdGuid,
                secondaryColor = ViewModel.SecondaryColor,
                northern = ViewModel.UseNorthCompass,
                camera = Server?.Camera
            });
            _overlay = null;
            if (_disposed)
            {
                await TearDownViewerAsync();
                return;
            }

            await LoadModelAsync();
            if (_disposed)
            {
                await TearDownViewerAsync();
                return;
            }

            await SyncInsetAsync();
            await SyncHeadingAsync();

            ViewModel.RotationChanged += OnRotationChanged;
            ViewModel.ConnectionChanged += OnVmConnectionChanged;
            ViewModel.StartTimerUpdates();
        }
        catch (JSDisconnectedException)
        {
            // circuit went away during start-up
        }
        catch (Exception ex)
        {
            _overlay = ex.Message;
            _overlayIsError = true;
            ViewModel.StatusText = L.T("Initialization error: {0}", ex.Message);
        }

        StateHasChanged();
    }

    private void OnRotationChanged()
    {
        if (!_modelLoaded)
        {
            // The model failed to load: try again now and then while updates come in.
            if (_loadFailedAt is { } failedAt && DateTime.UtcNow - failedAt >= RetryLoadAfter)
            {
                _loadFailedAt = DateTime.UtcNow; // one retry per interval, however often updates come
                _ = InvokeAsync(ReloadModelIfChangedAsync);
            }
            return;
        }
        // The same pose as the browser already has (a parked or still mount, every poll): nothing to send.
        lock (_sentPoseLock)
            if (_sentPose == ViewModel.CurrentPose) return;
        // Drop updates while one is still in flight to the browser (like the desktop TimerLock).
        if (Interlocked.Exchange(ref _rotationPending, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            try { await SetPoseAsync(); }
            finally { Interlocked.Exchange(ref _rotationPending, 0); }
        });
    }

    /// <summary>Sends GSServer's model transform for the current axis positions to the viewer.</summary>
    private async Task SetPoseAsync()
    {
        if (_module is null || _viewer is null) return;
        try
        {
            var pose = ViewModel.CurrentPose;
            var (x, y, z, yCentre) = pose;
            await _module.InvokeVoidAsync("setPose", _viewer, x, y, z, yCentre);
            lock (_sentPoseLock) _sentPose = pose;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ViewModel.RotationChanged -= OnRotationChanged;
        ViewModel.ConnectionChanged -= OnVmConnectionChanged;
        if (_watchedServer is not null) _watchedServer.PropertyChanged -= OnServerPropertyChanged;
        base.Dispose(); // detaches and disposes the view model
        await TearDownViewerAsync();
    }

    /// <summary>Disposes the Babylon viewer and the JS module, if they were created.</summary>
    private async Task TearDownViewerAsync()
    {
        var module = _module;
        var viewer = _viewer;
        _module = null;
        _viewer = null;
        try
        {
            if (module is not null && viewer is not null)
                await module.InvokeVoidAsync("dispose", viewer);
            if (viewer is not null) await viewer.DisposeAsync();
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
