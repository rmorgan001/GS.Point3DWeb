<Project Sdk="Microsoft.NET.Sdk">

  <!-- Issues GS Point3D Web feature keys. Holds the PRIVATE signing key: never ship this tool
       or its key file with the web app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The key format and the web app's public key: the same file the app compiles, so they always agree. -->
    <Compile Include="..\..\GS.Point3DWeb\Support\FeatureKeyFormat.cs" Link="FeatureKeyFormat.cs" />
  </ItemGroup>

</Project>
